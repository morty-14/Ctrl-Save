@model List<Ctrl_Save.Controllers.CartItem>

@{
    ViewData["Title"] = "Your Cart";
}

<div class="cs-breadcrumb">
    <div class="container-fluid">
        <nav aria-label="breadcrumb">
            <ol class="breadcrumb mb-0">
                <li class="breadcrumb-item"><a asp-controller="Home" asp-action="Index">Home</a></li>
                <li class="breadcrumb-item active">Your Cart</li>
            </ol>
        </nav>
    </div>
</div>

<div class="container">
    <div class="cs-cart-page">
        <h2 class="cs-cart-title"><i class="bi bi-cart3 me-2"></i>Your Cart</h2>

        @if (TempData["SoldItems"] != null)
        {
            <div class="alert alert-warning">
                <i class="bi bi-exclamation-triangle me-2"></i>
                The following item(s) were sold before you could complete your order and have been removed from your cart: <strong>@TempData["SoldItems"]</strong>
            </div>
        }

        @if (!Model.Any())
        {
            <div class="cs-cart-empty">
                <i class="bi bi-cart-x"></i>
                <p>Your cart is empty.</p>
                <a asp-controller="Home" asp-action="Index" class="cs-btn">Browse Products</a>
            </div>
        }
        else
        {
            <div class="cs-cart-items" id="cartItems">
                @foreach (var item in Model)
                {
                    <div class="cs-cart-item" id="item-@item.Id">
                        <img src="~/images/products/@item.Category/@item.Image" alt="@item.Name" />
                        <div class="cs-cart-item-info">
                            <div class="cs-cart-item-name">@item.Name</div>
                            <div class="cs-cart-item-price">@item.Price</div>
                        </div>
                        <button class="cs-cart-remove" onclick="removeItem('@item.Id')">
                            <i class="bi bi-trash me-1"></i>Remove
                        </button>
                    </div>
                }
            </div>

            <div class="cs-cart-summary">
                <div class="cs-cart-total">
                    <span>Total</span>
                    <span id="cartTotal">N$@Model.Sum(i => {
                        var p = i.Price.Replace("N$", "").Replace(",", "");
                        return decimal.TryParse(p, out var v) ? v : 0;
                    }).ToString("N0")</span>
                </div>
                <a asp-controller="Cart" asp-action="Checkout" class="cs-btn cs-checkout-btn">
                    Proceed to Checkout
                </a>
            </div>
        }
    </div>
</div>

@section Scripts {
    <script>
        function removeItem(id) {
            fetch('/Cart/Remove', {
                method: 'POST',
                headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
                body: 'id=' + id
            })
            .then(r => r.json())
            .then(data => {
                document.getElementById('item-' + id)?.remove();
                var badge = document.getElementById('cartBadge');
                if (badge) badge.textContent = data.count;

                if (data.count === 0) {
                    location.reload();
                }
            });
        }
    </script>
}
