@model Ctrl_Save.Controllers.CheckoutViewModel

@{
    ViewData["Title"] = "Checkout";
}

<div class="cs-breadcrumb">
    <div class="container-fluid">
        <nav aria-label="breadcrumb">
            <ol class="breadcrumb mb-0">
                <li class="breadcrumb-item"><a asp-controller="Home" asp-action="Index">Home</a></li>
                <li class="breadcrumb-item"><a asp-controller="Cart" asp-action="Index">Cart</a></li>
                <li class="breadcrumb-item active">Checkout</li>
            </ol>
        </nav>
    </div>
</div>

<div class="container cs-checkout-page">
    <div class="row g-4">
        <div class="col-md-7">
            <form asp-action="PlaceOrder" method="post">
                <p style="font-size:0.85rem; color:#888;"><span style="color:red;">*</span> Required fields</p>

                <!-- Personal Details -->
                <div class="cs-form-section mb-3">
                    <div class="cs-form-heading">Personal Details</div>
                    <div class="row g-3">
                        <div class="col-sm-6">
                            <label class="form-label">First Name <span style="color:red;">*</span></label>
                            <input asp-for="FirstName" class="form-control" required />
                        </div>
                        <div class="col-sm-6">
                            <label class="form-label">Last Name <span style="color:red;">*</span></label>
                            <input asp-for="LastName" class="form-control" required />
                        </div>
                        <div class="col-12">
                            <label class="form-label">Phone Number <span style="color:red;">*</span></label>
                            <input asp-for="Phone" class="form-control" placeholder="+264811234567" required
                                   oninput="this.value = this.value.replace(/[^\d+]/g, '')" />
                        </div>
                    </div>
                </div>

                <!-- Delivery Details -->
                <div class="cs-form-section mb-3">
                    <div class="cs-form-heading">Delivery Details</div>
                    <div class="row g-3">
                        <div class="col-12">
                            <label class="form-label">Address <span style="color:red;">*</span></label>
                            <input asp-for="Address" class="form-control" placeholder="ERF 5 Tacoma Street, Suiderhof" required />
                        </div>
                        <div class="col-sm-6">
                            <label class="form-label">City <span style="color:red;">*</span></label>
                            <select asp-for="City" class="form-select" id="citySelect" onchange="autoFillRegion()" required>
                                <option value="">Select city...</option>
                                <option value="Windhoek">Windhoek</option>
                                <option value="Swakopmund">Swakopmund</option>
                                <option value="Walvis Bay">Walvis Bay</option>
                                <option value="Henties Bay">Henties Bay</option>
                                <option value="Oshakati">Oshakati</option>
                                <option value="Ondangwa">Ondangwa</option>
                                <option value="Rundu">Rundu</option>
                                <option value="Katima Mulilo">Katima Mulilo</option>
                                <option value="Lüderitz">Lüderitz</option>
                                <option value="Keetmanshoop">Keetmanshoop</option>
                                <option value="Otjiwarongo">Otjiwarongo</option>
                                <option value="Grootfontein">Grootfontein</option>
                                <option value="Gobabis">Gobabis</option>
                                <option value="Mariental">Mariental</option>
                                <option value="Rehoboth">Rehoboth</option>
                                <option value="Tsumeb">Tsumeb</option>
                                <option value="Outapi">Outapi</option>
                                <option value="Eenhana">Eenhana</option>
                                <option value="Opuwo">Opuwo</option>
                                <option value="Nkurenkuru">Nkurenkuru</option>
                                <option value="Oshikango">Oshikango</option>
                                <option value="Okahandja">Okahandja</option>
                                <option value="Karibib">Karibib</option>
                                <option value="Usakos">Usakos</option>
                            </select>
                        </div>
                        <div class="col-sm-6">
                            <label class="form-label">Region <span style="color:red;">*</span></label>
                            <input asp-for="Region" class="form-control" id="regionInput" readonly />
                        </div>
                    </div>
                </div>

                <!-- Payment Method -->
                <div class="cs-form-section mb-3">
                    <div class="cs-form-heading">Payment Method <span style="color:red;">*</span></div>
                    <div class="cs-payment-options">
                        <label class="cs-payment-option">
                            <input type="radio" name="PaymentMethod" value="Cash on Delivery" checked />
                            <div class="cs-payment-label">
                                <i class="bi bi-cash-stack"></i>
                                Cash on Delivery
                            </div>
                        </label>
                        <label class="cs-payment-option">
                            <input type="radio" name="PaymentMethod" value="EFT" id="eftRadio" />
                            <div class="cs-payment-label">
                                <i class="bi bi-phone"></i>
                                EFT / e-Wallet
                            </div>
                        </label>
                    </div>
                    <div class="cs-eft-info" id="eftInfo" style="display:none;">
                        <i class="bi bi-info-circle me-2"></i>
                        Transfer payment to <strong>+264 81 287 5784</strong> and use your order number as reference.<br />
                        <small class="mt-1 d-block">Accepted: Standard Bank BlueVoucher, FNB eWallet, Bank Windhoek EasyWallet, Nedbank MobiMoney</small>
                    </div>
                </div>

                <!-- Hidden items -->
                @foreach (var item in Model.Items)
                {
                    <input type="hidden" name="Items[@Model.Items.IndexOf(item)].Id" value="@item.Id" />
                    <input type="hidden" name="Items[@Model.Items.IndexOf(item)].Name" value="@item.Name" />
                    <input type="hidden" name="Items[@Model.Items.IndexOf(item)].Price" value="@item.Price" />
                    <input type="hidden" name="Items[@Model.Items.IndexOf(item)].Image" value="@item.Image" />
                    <input type="hidden" name="Items[@Model.Items.IndexOf(item)].Category" value="@item.Category" />
                }

                <button type="submit" id="placeOrderBtn" class="cs-btn cs-btn-added w-100 mt-2" disabled>Place Order</button>
            </form>
        </div>

        <!-- Order Summary -->
        <div class="col-md-5">
            <div class="cs-order-summary">
                <div class="cs-summary-heading">Order Summary</div>
                @foreach (var item in Model.Items)
                {
                    <div class="cs-summary-item">
                        <span>@item.Name</span>
                        <span>@item.Price</span>
                    </div>
                }
                <div class="cs-summary-total">
                    <span>Total</span>
                    <span>N$@Model.Items.Sum(i => {
                        var p = i.Price.Replace("N$", "").Replace(",", "");
                        return decimal.TryParse(p, out var v) ? v : 0;
                    }).ToString("N0")</span>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        var cityRegions = {
            'Windhoek': 'Khomas', 'Swakopmund': 'Erongo', 'Walvis Bay': 'Erongo',
            'Henties Bay': 'Erongo', 'Oshakati': 'Oshana', 'Ondangwa': 'Oshana', "Ongwediva": "Oshana",
            'Rundu': 'Kavango East', 'Katima Mulilo': 'Zambezi', 'Lüderitz': 'Karas',
            'Keetmanshoop': 'Karas', 'Otjiwarongo': 'Otjozondjupa', 'Grootfontein': 'Otjozondjupa',
            'Gobabis': 'Omaheke', 'Mariental': 'Hardap', 'Rehoboth': 'Hardap',
            'Tsumeb': 'Oshikoto', 'Outapi': 'Omusati', 'Eenhana': 'Ohangwena',
            'Opuwo': 'Kunene', 'Nkurenkuru': 'Kavango West', 'Oshikango': 'Ohangwena',
            'Okahandja': 'Otjozondjupa', 'Karibib': 'Erongo', 'Usakos': 'Erongo'
        };

        function autoFillRegion() {
            var city = document.getElementById('citySelect').value;
            document.getElementById('regionInput').value = cityRegions[city] || '';
            validateCheckout();
        }

        document.querySelectorAll('input[name="PaymentMethod"]').forEach(function(radio) {
            radio.addEventListener('change', function() {
                document.getElementById('eftInfo').style.display =
                    this.value === 'EFT' ? '' : 'none';
            });
        });

        function validateCheckout() {
            var firstName = document.getElementById('FirstName').value.trim();
            var lastName = document.getElementById('LastName').value.trim();
            var phone = document.getElementById('Phone').value.trim();
            var address = document.getElementById('Address').value.trim();
            var city = document.getElementById('citySelect').value;
            var region = document.getElementById('regionInput').value.trim();
            var valid = firstName && lastName && phone && address && city && region;
            var btn = document.getElementById('placeOrderBtn');
            btn.disabled = !valid;
            btn.classList.toggle('cs-btn-added', !valid);
        }

        document.querySelectorAll('input, select').forEach(function(el) {
            el.addEventListener('input', validateCheckout);
            el.addEventListener('change', validateCheckout);
        });
    </script>
}
