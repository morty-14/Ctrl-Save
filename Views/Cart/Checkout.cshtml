@model Ctrl_Save.Controllers.CheckoutViewModel

@{
    ViewData["Title"] = "Checkout";
}

<div class="cs-breadcrumb">
    <div class="container-fluid">
        <nav aria-label="breadcrumb">
            <ol class="breadcrumb mb-0">
                <li class="breadcrumb-item"><a asp-controller="Home" asp-action="Index">Home</a></li>
                <li class="breadcrumb-item"><a asp-controller="Cart" asp-action="Index">Cart</a></li>
                <li class="breadcrumb-item active">Checkout</li>
            </ol>
        </nav>
    </div>
</div>

<div class="container cs-checkout-page">
    <h1 class="cs-cart-title"><i class="bi bi-credit-card me-2"></i>Checkout</h1>

    <div class="row g-4">
        <!-- ORDER SUMMARY -->
        <div class="col-md-4 order-md-2">
            <div class="cs-order-summary">
                <h6 class="cs-summary-heading">Order Summary</h6>
                @foreach (var item in Model.Items)
                {
                    <div class="cs-summary-item">
                        <span>@item.Name @(item.Quantity > 1 ? "x" + item.Quantity : "")</span>
                        <span>@item.Price</span>
                    </div>
                }
                <div class="cs-summary-total">
                    @{
                        var total = Model.Items.Sum(i => decimal.Parse(i.Price.Replace("N$", "").Replace(",", "")) * i.Quantity);
                    }
                    <span>Total</span>
                    <span>N$@total.ToString("N0")</span>
                </div>
            </div>
        </div>

        <!-- CHECKOUT FORM -->
        <div class="col-md-8 order-md-1">
            <form method="post" asp-action="PlaceOrder">
                <div class="cs-form-section">
                    <h6 class="cs-form-heading">Your Details</h6>
                    <div class="row g-3">
                        <div class="col-sm-6">
                            <label class="form-label">First Name*</label>
                            <input class="form-control" name="FirstName" required />
                        </div>
                        <div class="col-sm-6">
                            <label class="form-label">Last Name*</label>
                            <input class="form-control" name="LastName" required />
                        </div>
                        <div class="col-sm-6">
                            <label class="form-label">Phone Number*</label>
                            <input class="form-control" name="Phone" type="tel" 
                                   placeholder="+264811234567"
                                   pattern="\+264(81|85|83)\d{7}"
                                   title="Format: +264 followed by 081, 085, or 083 and 7 digits (e.g. +264811234567)"
                                   required />
                            <div class="form-text">+264 (081/085/083) followed by 7 digits</div>
                        </div>
                        <div class="col-12">
                            <label class="form-label">Delivery Address*</label>
                            <input class="form-control" name="Address" required />
                        </div>
                        <div class="col-sm-6">
                            <label class="form-label">City*</label>
                            <select class="form-select" name="City" id="citySelect" onchange="updateRegion()" required>
                                <option value="">Select a city...</option>
                                <optgroup label="Khomas">
                                    <option value="Windhoek">Windhoek</option>
                                </optgroup>
                                <optgroup label="Erongo">
                                    <option value="Swakopmund">Swakopmund</option>
                                    <option value="Walvis Bay">Walvis Bay</option>
                                    <option value="Henties Bay">Henties Bay</option>
                                </optgroup>
                                <optgroup label="Oshana">
                                    <option value="Oshakati">Oshakati</option>
                                    <option value="Ondangwa">Ondangwa</option>
                                </optgroup>
                                <optgroup label="Kavango East">
                                    <option value="Rundu">Rundu</option>
                                </optgroup>
                                <optgroup label="Zambezi">
                                    <option value="Katima Mulilo">Katima Mulilo</option>
                                </optgroup>
                                <optgroup label="Karas">
                                    <option value="Lüderitz">Lüderitz</option>
                                    <option value="Keetmanshoop">Keetmanshoop</option>
                                </optgroup>
                                <optgroup label="Otjozondjupa">
                                    <option value="Otjiwarongo">Otjiwarongo</option>
                                    <option value="Grootfontein">Grootfontein</option>
                                </optgroup>
                                <optgroup label="Omaheke">
                                    <option value="Gobabis">Gobabis</option>
                                </optgroup>
                                <optgroup label="Hardap">
                                    <option value="Mariental">Mariental</option>
                                    <option value="Rehoboth">Rehoboth</option>
                                </optgroup>
                                <optgroup label="Oshikoto">
                                    <option value="Tsumeb">Tsumeb</option>
                                    <option value="Omuthiya">Omuthiya</option>
                                </optgroup>
                                <optgroup label="Omusati">
                                    <option value="Outapi">Outapi</option>
                                    <option value="Okahao">Okahao</option>
                                </optgroup>
                                <optgroup label="Ohangwena">
                                    <option value="Eenhana">Eenhana</option>
                                    <option value="Helao Nafidi">Helao Nafidi</option>
                                </optgroup>
                                <optgroup label="Kunene">
                                    <option value="Opuwo">Opuwo</option>
                                    <option value="Khorixas">Khorixas</option>
                                </optgroup>
                                <optgroup label="Kavango West">
                                    <option value="Nkurenkuru">Nkurenkuru</option>
                                </optgroup>
                            </select>
                        </div>
                        <div class="col-sm-6">
                            <label class="form-label">Region</label>
                            <input class="form-control" name="Region" id="regionInput" readonly placeholder="Auto-filled from city" />
                        </div>
                    </div>
                </div>

                <div class="cs-form-section mt-4">
                    <h6 class="cs-form-heading">Payment Method</h6>
                    <div class="cs-payment-options">
                        <label class="cs-payment-option">
                            <input type="radio" name="PaymentMethod" value="Cash on Delivery" onchange="showPaymentInfo(this.value)" required />
                            <div class="cs-payment-label">
                                <i class="bi bi-truck"></i>
                                <span>Cash on Delivery</span>
                            </div>
                        </label>
                        <label class="cs-payment-option">
                            <input type="radio" name="PaymentMethod" value="EFT" onchange="showPaymentInfo(this.value)" />
                            <div class="cs-payment-label">
                                <i class="bi bi-phone"></i>
                                <span>EFT</span>
                            </div>
                        </label>
                    </div>

                    <div id="eftInfo" class="cs-eft-info d-none">
                        <i class="bi bi-info-circle me-2"></i>
                        To pay via EFT, send your payment to <strong>+264 81 287 5784</strong>.
                        If you need bank transfer details, contact us on that number for further information.
                    </div>
                </div>

                <button type="submit" class="cs-btn cs-checkout-btn mt-4">
                    <i class="bi bi-check-circle me-2"></i>Place Order
                </button>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        const cityRegionMap = {
            "Windhoek": "Khomas",
            "Swakopmund": "Erongo",
            "Walvis Bay": "Erongo",
            "Henties Bay": "Erongo",
            "Oshakati": "Oshana",
            "Ondangwa": "Oshana",
            "Rundu": "Kavango East",
            "Katima Mulilo": "Zambezi",
            "Lüderitz": "Karas",
            "Keetmanshoop": "Karas",
            "Otjiwarongo": "Otjozondjupa",
            "Grootfontein": "Otjozondjupa",
            "Gobabis": "Omaheke",
            "Mariental": "Hardap",
            "Rehoboth": "Hardap",
            "Tsumeb": "Oshikoto",
            "Omuthiya": "Oshikoto",
            "Outapi": "Omusati",
            "Okahao": "Omusati",
            "Eenhana": "Ohangwena",
            "Helao Nafidi": "Ohangwena",
            "Opuwo": "Kunene",
            "Khorixas": "Kunene",
            "Nkurenkuru": "Kavango West"
        };

        function updateRegion() {
            const city = document.getElementById('citySelect').value;
            const regionInput = document.getElementById('regionInput');
            regionInput.value = cityRegionMap[city] || '';
        }

        function showPaymentInfo(value) {
            const eftInfo = document.getElementById('eftInfo');
            eftInfo.classList.toggle('d-none', value !== 'EFT');
        }
    </script>
}
