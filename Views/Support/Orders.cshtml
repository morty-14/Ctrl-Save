@{
    ViewData["Title"] = "Orders";
}

<div class="cs-content-page">
    <h1>ORDERS</h1>

    <div class="cs-faq-item">
        <h6>How can I track my order?</h6>
        <p>Your order can be tracked after it has been processed through your account on the website.</p>
    </div>

    <div class="cs-faq-item">
        <h6>What do I do if my item is delayed?</h6>
        <p>Please contact support to be assisted if your item is taking longer than expected to arrive.</p>
    </div>

    <div class="cs-faq-item">
        <h6>Will I get a proof of purchase for my order?</h6>
        <p>Yes, your order invoice will be displayed on your screen after successful checkout and confirmation details will be sent to your phone number.</p>
    </div>

    <div class="cs-faq-item">
        <h6>Will I be contacted before my delivery?</h6>
        <p>Yes, the assigned courier service or our designated driver wil call you to verify your delivery address.</p>
    </div>

    <div class="text-center mt-4">
        <a asp-controller="Support" asp-action="Index" class="cs-btn">Back to Support Hub</a>
    </div>
</div>
