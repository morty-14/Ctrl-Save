@{
    ViewData["Title"] = "Warranty";
}

<div class="cs-content-page">
    <h1>WARRANTY</h1>

    <div class="cs-faq-item">
        <h6>What does the warranty cover?</h6>
        <p>Any issues that weren't known at the time of buying your item, guarantees that your item works.</p>
    </div>

    <div class="cs-faq-item">
        <h6>What does the warranty NOT cover?</h6>
        <p>ANy misuse which causes damage, accidents, or natural "wear and tear"."</p>
    </div>

    <div class="cs-faq-item">
        <h6>Can a refund be given instead of a replacement?</h6>
        <p>If a replacement is not possible, a refund may be given.</p>
    </div>

    <div class="cs-faq-item">
        <h6>How do I make a warranty claim?</h6>
        <p>Contact our team to submit a claim, along with the details of your order and a description of the issue at hand.</p>
    </div>

    <div class="text-center mt-4">
        <a asp-controller="Support" asp-action="Index" class="cs-btn">Back to Support Hub</a>
    </div>
</div>
