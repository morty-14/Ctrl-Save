@model Ctrl_Save.Models.Product

@{
    ViewData["Title"] = Model.Name;
}

<div class="cs-breadcrumb">
    <div class="container-fluid">
        <nav aria-label="breadcrumb">
            <ol class="breadcrumb mb-0">
                <li class="breadcrumb-item"><a asp-controller="Home" asp-action="Index">Home</a></li>
                <li class="breadcrumb-item"><a asp-controller="Camera" asp-action="Index">Camera</a></li>
                <li class="breadcrumb-item active" aria-current="page">@Model.Name</li>
            </ol>
        </nav>
    </div>
</div>

<div class="container cs-detail-page">
    <div class="row g-4">
        <div class="col-md-5">
            <div class="cs-detail-img-wrap">
                <img src="~/images/products/camera/@Model.Image" alt="@Model.Name" />
            </div>
        </div>
        <div class="col-md-7">
            <h1 class="cs-detail-title">@Model.Name</h1>
            <div class="cs-detail-price">@Model.Price</div>
            <div class="cs-detail-meta">
                <div class="cs-detail-meta-item">
                    <span class="cs-meta-label">Condition</span>
                    <span class="cs-condition-badge cs-condition-@Model.Condition.ToLower().Replace(" ", "-")">@Model.Condition</span>
                </div>
                <div class="cs-detail-meta-item">
                    <span class="cs-meta-label">Listed</span>
                    <span>@Model.Listed</span>
                </div>
            </div>
            <div class="cs-detail-section">
                <h6></h6>
                <p></p>
            </div>
            <div class="cs-detail-section">
                <h6>What's included</h6>
                <p>@Model.Includes</p>
            </div>
            <button class="cs-btn cs-add-to-cart w-100 mt-3" id="addToCartBtn"
                    onclick="addToCart('@Model.ProductId', '@Model.Name', '@Model.Price', '@Model.Image', 'camera')">
                <i class="bi bi-cart-plus me-2" id="addToCartIcon"></i>
                <span id="addToCartText">Add to Cart</span>
            </button>
        </div>
    </div>
</div>

<div class="cs-toast" id="cartToast">
    <div>
        <i class="bi bi-check-circle-fill me-2"></i>
        <span id="cartToastMsg"></span>
    </div>
    <div class="d-flex align-items-center gap-2 mt-1">
        <a href="/Cart" class="cs-toast-link">View Cart</a>
        <button class="cs-toast-close" onclick="closeToast()"><i class="bi bi-x"></i></button>
    </div>
</div>

@section Scripts {
    <script>
        const productId = '@Model.ProductId';

        fetch('/Cart/Contains?id=' + encodeURIComponent(productId))
            .then(r => r.json())
            .then(data => { if (data.inCart) setAddedState(); });

        function addToCart(id, name, price, image, category) {
            fetch('/Cart/Add', {
                method: 'POST',
                headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
                body: `id=${encodeURIComponent(id)}&name=${encodeURIComponent(name)}&price=${encodeURIComponent(price)}&image=${encodeURIComponent(image)}&category=${encodeURIComponent(category)}`
            })
            .then(r => r.json())
            .then(data => {
                document.getElementById('cartBadge').textContent = data.count;
                document.getElementById('cartToastMsg').textContent = name + ' added to cart!';
                const toast = document.getElementById('cartToast');
                toast.classList.add('show');
                setTimeout(() => toast.classList.remove('show'), 4000);
                setAddedState();
            });
        }

        function setAddedState() {
            const btn = document.getElementById('addToCartBtn');
            const icon = document.getElementById('addToCartIcon');
            const text = document.getElementById('addToCartText');
            btn.disabled = true;
            btn.classList.add('cs-btn-added');
            icon.className = 'bi bi-check-circle me-2';
            text.textContent = 'Added to Cart';
        }

        function closeToast() {
            document.getElementById('cartToast').classList.remove('show');
        }
    </script>
}
