@model List<Ctrl_Save.Models.Product>

@{
    ViewData["Title"] = "Camera";
}
<div class="cs-breadcrumb"><div class="container-fluid"><nav aria-label="breadcrumb"><ol class="breadcrumb mb-0"><li class="breadcrumb-item"><a asp-controller="Home" asp-action="Index">Home</a></li><li class="breadcrumb-item active" aria-current="page">Camera</li></ol></nav></div></div><div class="cs-section-header"><div class="container-fluid d-flex align-items-center justify-content-between"><div><h2><i class=""></i>CAMERA</h2><p>Capture moments that last longer than a memory.</p></div><div class="d-flex align-items-center gap-3"><div class="d-none d-md-flex gap-3 align-items-center" style="font-size: 2.5rem; color: var(--cs-green);"><i class="bi bi-camera"></i> <i class="bi bi-camera-video"></i> <i class="bi bi-record-circle"></i></div><select class="cs-filter-select" id="sortSelect" onchange="sortProducts()"><option value="default">Sort by</option><option value="price-asc">Price: Low to High</option><option value="price-desc">Price: High to Low</option><option value="alpha">Alphabetical</option></select><div class="cs-view-toggle"><button class="cs-view-btn active" id="gridBtn" onclick="setView('grid')" title="Grid view"><i class="bi bi-grid"></i></button><button class="cs-view-btn" id="listBtn" onclick="setView('list')" title="List view"><i class="bi bi-list-ul"></i></button></div></div></div></div><div class="cs-product-grid" id="productGrid"><div class="container-fluid"><div class="row g-3" id="productRow">
            @foreach (var product in Model)
            {
                var priceNum = product.Price.Replace("N$", "").Replace(",", "");
                <div class="col-6 col-sm-4 col-md-3 cs-product-item" data-name="@product.Name" data-price="@priceNum"><a asp-controller="Camera" asp-action="Detail" asp-route-id="@product.ProductId" class="text-decoration-none"><div class="cs-product-card"><div style="position:relative;"><img src="~/images/products/camera/@product.Image" alt="@product.Name" style="@(!product.IsAvailable ? "filter:grayscale(60%) opacity(0.7);" : "")" />@if (!product.IsAvailable){<div style="position:absolute; top:0; left:0; width:100%; height:100%; display:flex; align-items:center; justify-content:center; pointer-events:none;"><div style="background:rgba(180,0,0,0.75); color:#fff; font-weight:800; font-size:1.1rem; letter-spacing:2px; padding:0.4rem 2rem; transform:rotate(-35deg); white-space:nowrap; box-shadow:0 2px 8px rgba(0,0,0,0.3);">SOLD</div></div>}</div><div class="card-body"><div class="card-title">@product.Name</div><div class="card-price">@product.Price</div></div></div></a></div>
            }
        </div></div></div>
@section Scripts {
    <script>function setView(view) {
            const grid = document.getElementById('productGrid');
            const gridBtn = document.getElementById('gridBtn');
            const listBtn = document.getElementById('listBtn');
            if (view === 'list') {
                grid.classList.add('list-view');
                listBtn.classList.add('active');
                gridBtn.classList.remove('active');
            } else {
                grid.classList.remove('list-view');
                gridBtn.classList.add('active');
                listBtn.classList.remove('active');
            }
        }

        function sortProducts() {
            const sortValue = document.getElementById('sortSelect').value;
            const row = document.getElementById('productRow');
            const items = Array.from(row.querySelectorAll('.cs-product-item'));
            items.sort((a, b) => {
                if (sortValue === 'price-asc') return parseFloat(a.dataset.price) - parseFloat(b.dataset.price);
                if (sortValue === 'price-desc') return parseFloat(b.dataset.price) - parseFloat(a.dataset.price);
                if (sortValue === 'alpha') return a.dataset.name.localeCompare(b.dataset.name);
                return 0;
            });
            items.forEach(item => row.appendChild(item));
        }
    </script>}
