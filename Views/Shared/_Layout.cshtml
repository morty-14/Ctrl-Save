<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"]</title>
    <link rel="icon" type="image/png" href="~/images/cart-logo.png" />
    <script type="importmap"></script>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
    <header>
        <nav class="navbar navbar-expand-sm cs-navbar">
            <div class="container-fluid px-4">
                <a class="navbar-brand cs-brand" asp-controller="Home" asp-action="Index">
                    <img src="~/images/cart-logo.png" alt="Ctrl + Save" class="cs-brand-logo" />
                    CTRL + SAVE
                </a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target=".navbar-collapse">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="navbar-collapse collapse d-sm-inline-flex justify-content-between align-items-center">
                    <ul class="navbar-nav me-auto">
                    </ul>
                    <ul class="navbar-nav align-items-center gap-2">
                        <li class="nav-item">
                            <a class="nav-link cs-nav-link" asp-controller="Support" asp-action="Index">SUPPORT HUB</a>
                        </li>

                        <!-- SEARCH -->
                        <li class="nav-item cs-search-nav">
                            <form asp-controller="Search" asp-action="Index" method="get" class="cs-search-form" id="searchForm">
                                <input type="text" name="q" id="searchInput" class="cs-search-input" placeholder="Search products..." autocomplete="off" />
                                <button type="submit" class="cs-nav-link cs-search-toggle" id="searchToggle" onclick="toggleSearch(event)">
                                    <i class="bi bi-search"></i>
                                </button>
                            </form>
                        </li>

                        <!-- AUTH -->
                        @if (User.Identity?.IsAuthenticated == true)
                        {
                            <li class="nav-item dropdown">
                                <a class="nav-link cs-nav-link dropdown-toggle" href="#" role="button" data-bs-toggle="dropdown">
                                    <i class="bi bi-person-check me-1"></i>@User.Identity.Name
                                </a>
                                <ul class="dropdown-menu dropdown-menu-end">
                                    @if (User.IsInRole("admin"))
                                    {
                                        <li><a class="dropdown-item" asp-controller="Admin" asp-action="Index"><i class="bi bi-speedometer2 me-2"></i>Admin Panel</a></li>
                                        <li><hr class="dropdown-divider"></li>
                                    }
                                    <li><a class="dropdown-item" asp-controller="Auth" asp-action="Logout"><i class="bi bi-box-arrow-right me-2"></i>Logout</a></li>
                                </ul>
                            </li>
                        }
                        else
                        {
                            <li class="nav-item">
                                <a class="nav-link cs-nav-link" asp-controller="Auth" asp-action="Login">
                                    <i class="bi bi-person me-1"></i>Login
                                </a>
                            </li>
                        }

                        <!-- CART -->
                        <li class="nav-item">
                            <a class="nav-link cs-nav-link cs-cart-nav" asp-controller="Cart" asp-action="Index">
                                <i class="bi bi-cart3"></i>
                                <span class="cs-cart-badge" id="cartBadge">0</span>
                            </a>
                        </li>
                    </ul>
                </div>
            </div>
        </nav>
    </header>

    <main role="main">
        @RenderBody()
    </main>

    <footer class="cs-footer mt-5">
        <div class="container py-3 text-center">
            <span>&copy; 2026 Ctrl + Save &mdash; <a asp-controller="Home" asp-action="Privacy">Privacy Policy</a></span>
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    <script src="~/js/image-zoom.js" asp-append-version="true"></script>
    <script>
        fetch('/Cart/Count')
            .then(r => r.json())
            .then(data => {
                const badge = document.getElementById('cartBadge');
                if (badge) badge.textContent = data.count;
            });

        function toggleSearch(e) {
            const input = document.getElementById('searchInput');
            const form = document.getElementById('searchForm');
            if (!form.classList.contains('open')) {
                e.preventDefault();
                form.classList.add('open');
                input.focus();
            }
        }

        document.addEventListener('click', function (e) {
            const form = document.getElementById('searchForm');
            if (form && !form.contains(e.target)) {
                form.classList.remove('open');
            }
        });
    </script>
    @await RenderSectionAsync("Scripts", required: false)
    <script>initImageZoom();</script>
</body>
</html>
